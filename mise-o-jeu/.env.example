# Identifiants Mise O Jeu (miseojeu.com)
MOJ_USERNAME=votre_identifiant
MOJ_PASSWORD=votre_mot_de_passe

# Stratégie de mise
MAX_ODDS=1.02          # Cote maximale (ex: 1.02 = gain de 2% max)
MAX_EVENT_HOURS=24     # Durée maximale de l'événement en heures
BET_FRACTION=0.50      # Fraction du solde à miser (0.50 = 50%)

# Intervalle de vérification en minutes
CHECK_INTERVAL_MINUTES=15

# Mode simulation (true = ne place pas de vrais paris)
DRY_RUN=true
